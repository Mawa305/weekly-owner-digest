    {
      "parameters": {
        "jsCode": "const since = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\n\nfunction lastWeek(node, dateField) {\n  return $(node).all()\n    .map(i => i.json)\n    .filter(r => r[dateField] && new Date(r[dateField]) >= since);\n}\n\nconst missed = lastWeek('Get Missed Calls', 'timestamp');\nconst qualified = lastWeek('Get Qualified Leads', 'timestamp');\nconst unqualified = lastWeek('Get Unqualified Leads', 'timestamp');\nconst invalid = lastWeek('Get Invalid Submissions', 'timestamp');\nconst renewals = lastWeek('Get Renewals', 'created_at');\nconst reviews = lastWeek('Get Reviews', 'created_at');\n\nconst positive = reviews.filter(r => r.sentiment === 'positive').length;\nconst negative = reviews.filter(r => r.sentiment === 'negative').length;\n\nreturn [{\n  json: {\n    period: `${since.toISOString().slice(0, 10)} to ${new Date().toISOString().slice(0, 10)}`,\n    missed_calls: missed.length,\n    new_leads: qualified.length + unqualified.length,\n    qualified_leads: qualified.length,\n    unqualified_leads: unqualified.length,\n    invalid_submissions: invalid.length,\n    renewals: renewals.length,\n    reviews: reviews.length,\n    positive_reviews: positive,\n    negative_reviews: negative\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        288
      ],
      "id": "e048bae3-6e24-4ac8-9878-9ee76db6a008",
      "name": "Calculate Weekly Stats"
    },
